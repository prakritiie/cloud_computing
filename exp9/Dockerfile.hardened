FROM node:18-alpine

WORKDIR /app

# Create a non-root user
RUN addgroup -S appgroup && \
    adduser -S appuser -G appgroup

COPY package*.json ./

RUN npm ci --only=production

COPY . .

RUN chown -R appuser:appgroup /app

# Run application as non-root user
USER appuser

EXPOSE 3000

CMD ["node", "index.js"]